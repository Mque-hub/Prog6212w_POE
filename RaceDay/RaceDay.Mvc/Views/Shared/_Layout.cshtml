@{
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetInt32("UserId");
}
@if (userId == null)
{
    <a asp-controller="Auth" asp-action="Login">Login</a>
    <a asp-controller="Auth" asp-action="Register">Register</a>
}
else if (role == "Organiser")
{
    <a asp-controller="Organiser" asp-action="Index">Dashboard</a>
    <a asp-controller="Organiser" asp-action="Events">Events</a>
    <a asp-controller="Organiser" asp-action="Enrolments">Enrolments</a>
    <a asp-controller="Organiser" asp-action="Results">Results</a>
}
else
{
    <a asp-controller="Participant" asp-action="Index">Events</a>
    <a asp-controller="Participant" asp-action="MyEvents">My Events</a>
    <a asp-controller="Participant" asp-action="MyResults">My Results</a>
    <a asp-controller="Participant" asp-action="Profile">Profile</a>
}
