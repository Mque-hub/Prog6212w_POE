```cshtml
@model RaceDay.Mvc.ViewModels.LoginVm

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <h2 class="text-center mb-4">Login to RaceDay</h2>

            <form asp-controller="Auth" asp-action="Login" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control"
                           placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control"
                           placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AuthenticationRole" class="form-label">
                        Login As
                    </label>

                    <select asp-for="AuthenticationRole" class="form-select">
                        <option value="">Select your role</option>
                        <option value="Participant">Participant</option>
                        <option value="Organiser">Organiser</option>
                    </select>

                    <span asp-validation-for="AuthenticationRole"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Login
                </button>

            </form>

            <p class="text-center mt-3">
                Don't have an account?
                <a asp-controller="Auth" asp-action="Register">Register here</a>
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```