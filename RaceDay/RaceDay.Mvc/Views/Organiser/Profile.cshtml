@model RaceDay.Contracts.DTOs.OrganiserProfileDTO

@{
    ViewData["Title"] = "Organiser Profile";
}

<style>
    .profile-heading {
        color: #171717;
        font-weight: 700;
    }

    .profile-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    .profile-header {
        background: #171717;
        color: white;
        padding: 25px;
        text-align: center;
    }

    .profile-picture {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid white;
    }

    .profile-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: #525252;
        border: 4px solid white;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
    }

    .profile-section-title {
        font-weight: 700;
        color: #171717;
        border-bottom: 2px solid #B91C1C;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .btn-profile {
        background: #B91C1C;
        color: white;
        border: none;
    }

        .btn-profile:hover {
            background: #991B1B;
            color: white;
        }

    .profile-label {
        font-weight: 600;
        color: #525252;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="profile-heading">My Organiser Profile</h2>
            <p class="text-muted">
                Manage your personal information and profile picture.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-dark">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ProfileError"]
        </div>
    }

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileSuccess"]
        </div>
    }

    <div class="card profile-card shadow-sm">

        <div class="profile-header">

            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl"
                     alt="Organiser profile picture"
                     class="profile-picture" />
            }
            else
            {
                <div class="profile-placeholder">
                    No picture
                </div>
            }

            <h4 class="mt-3 mb-1">
                @Model.FirstName @Model.LastName
            </h4>

            <p class="mb-0 text-white-50">
                RaceDay Organiser
            </p>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-6">

                    <h5 class="profile-section-title">
                        Personal Information
                    </h5>

                    <dl class="row">

                        <dt class="col-sm-4 profile-label">
                            First Name
                        </dt>
                        <dd class="col-sm-8">
                            @Model.FirstName
                        </dd>

                        <dt class="col-sm-4 profile-label">
                            Last Name
                        </dt>
                        <dd class="col-sm-8">
                            @Model.LastName
                        </dd>

                        <dt class="col-sm-4 profile-label">
                            Email
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4 profile-label">
                            Address
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Address
                        </dd>

                    </dl>

                </div>

                <div class="col-lg-6">

                    <h5 class="profile-section-title">
                        Update Profile Picture
                    </h5>

                    <form asp-controller="Organiser"
                          asp-action="UploadProfilePicture"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                Choose a new profile picture
                            </label>

                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />
                        </div>

                        <small class="text-muted d-block mb-3">
                            JPG, PNG or WEBP. Maximum size: 5 MB.
                        </small>

                        <button type="submit"
                                class="btn btn-profile">
                            Upload Picture
                        </button>

                    </form>

                </div>

            </div>

            <hr class="my-4" />

            <h5 class="profile-section-title">
                Edit Personal Details
            </h5>

            <form asp-controller="Organiser"
                  asp-action="UpdateProfile"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            First Name
                        </label>

                        <input type="text"
                               name="FirstName"
                               value="@Model.FirstName"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Last Name
                        </label>

                        <input type="text"
                               name="LastName"
                               value="@Model.LastName"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">
                            Email Address
                        </label>

                        <input type="email"
                               value="@Model.Email"
                               class="form-control"
                               readonly />

                        <small class="text-muted">
                            Your registered email address cannot be changed here.
                        </small>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">
                            Address
                        </label>

                        <textarea name="Address"
                                  class="form-control"
                                  rows="3"
                                  required>@Model.Address</textarea>
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-profile">
                    Save Changes
                </button>

            </form>

        </div>
    </div>
</div>
