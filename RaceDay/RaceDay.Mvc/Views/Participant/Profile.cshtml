@model RaceDay.Contracts.DTOs.ParticipantProfileDto

@{
    ViewData["Title"] = "My Profile";
}

<style>
    .profile-page {
        color: #262E57;
    }

    .profile-header {
        background: #262E57;
        color: white;
        border-radius: 14px;
        padding: 30px;
        margin-bottom: 28px;
    }

    .profile-picture {
        width: 125px;
        height: 125px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #A5E9E8;
        background: white;
    }

    .profile-placeholder {
        width: 125px;
        height: 125px;
        border-radius: 50%;
        border: 4px solid #A5E9E8;
        background: #ffffff;
        color: #262E57;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: bold;
    }

    .profile-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        margin-bottom: 24px;
    }

    .profile-section-title {
        font-weight: 700;
        border-bottom: 3px solid #C32B42;
        padding-bottom: 10px;
        margin-bottom: 22px;
        color: #262E57;
    }

    .profile-label {
        font-weight: 600;
        color: #262E57;
        margin-bottom: 6px;
    }

    .profile-value {
        color: #555;
        padding: 10px 12px;
        background: #f8f9fa;
        border-radius: 7px;
        min-height: 42px;
    }

    .btn-profile {
        background: #C32B42;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 7px;
        font-weight: 600;
    }

        .btn-profile:hover {
            background: #a82035;
            color: white;
        }

    .btn-dashboard {
        background: #262E57;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-dashboard:hover {
            background: #1b2142;
            color: white;
        }

    .profile-page .form-control:focus {
        border-color: #A5E9E8;
        box-shadow: 0 0 0 0.2rem rgba(165, 233, 232, 0.35);
    }
</style>

<div class="container mt-4 mb-5 profile-page">

    <div class="profile-header">
        <div class="row align-items-center">
            <div class="col-md-auto text-center mb-3 mb-md-0">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl"
                         alt="Participant profile picture"
                         class="profile-picture" />
                }
                else
                {
                    <div class="profile-placeholder mx-auto">
                        @(string.IsNullOrWhiteSpace(Model.FirstName)
                                            ? "?"
                                            : Model.FirstName.Substring(0, 1).ToUpper())
                </div>
                                }
            </div>

            <div class="col-md">
                <h2 class="fw-bold mb-1">
                    @(Model.FirstName) @(Model.LastName)
                </h2>
                <p class="mb-0 opacity-75">Participant Profile</p>
                <small class="opacity-75">
                    Manage your personal information and profile picture.
                </small>
            </div>
        </div>
    </div>

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ProfileError"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["ProfileSuccess"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">

        <div class="col-lg-5">

            <div class="profile-card">
                <h5 class="profile-section-title">Profile Picture</h5>

                <form asp-controller="Participant"
                      asp-action="UploadProfilePicture"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="profile-label" for="profilePicture">
                            Choose a new picture
                        </label>

                        <input type="file"
                               id="profilePicture"
                               name="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               required />
                    </div>

                    <small class="text-muted d-block mb-3">
                        Accepted formats: JPG, PNG and WEBP.
                        Maximum file size: 5 MB.
                    </small>

                    <button type="submit" class="btn-profile">
                        Upload Picture
                    </button>
                </form>
            </div>

            <div class="profile-card">
                <h5 class="profile-section-title">Account Information</h5>

                <div class="mb-3">
                    <div class="profile-label">Email Address</div>
                    <div class="profile-value">
                        @Model.Email
                    </div>
                </div>

                <small class="text-muted">
                    Your email address is managed through your account
                    and cannot be changed here.
                </small>
            </div>

        </div>

        <div class="col-lg-7">

            <div class="profile-card">
                <h5 class="profile-section-title">Personal Information</h5>

                <form asp-controller="Participant"
                      asp-action="UpdateProfile"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="profile-label"
                                   for="FirstName">First Name</label>

                            <input type="text"
                                   id="FirstName"
                                   name="FirstName"
                                   class="form-control"
                                   value="@Model.FirstName"
                                   required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="profile-label"
                                   for="LastName">Last Name</label>

                            <input type="text"
                                   id="LastName"
                                   name="LastName"
                                   class="form-control"
                                   value="@Model.LastName"
                                   required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="profile-label"
                               for="CellNumber">Cell Number</label>

                        <input type="tel"
                               id="CellNumber"
                               name="CellNumber"
                               class="form-control"
                               value="@Model.CellNumber"
                               required />
                    </div>

                    <div class="mb-4">
                        <label class="profile-label"
                               for="Address">Address</label>

                        <textarea id="Address"
                                  name="Address"
                                  class="form-control"
                                  rows="3"
                                  required>@Model.Address</textarea>
                    </div>

                    <button type="submit" class="btn-profile">
                        Save Changes
                    </button>
                </form>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn-dashboard">
            Back to Dashboard
        </a>
    </div>

</div>
