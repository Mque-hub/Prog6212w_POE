@model RaceDay.Mvc.ViewModels.MyEnrolmentsVm

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="mb-3">My Enrolments</h2>

    <p class="text-muted">
        View and manage the events you have entered.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            You have not entered any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Enrolments)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="ParticipantEvents"
       class="btn btn-primary mt-3">
        Browse Available Events
    </a>
</div>
