@model List<RaceDay.Mvc.ViewModels.EventParticipantViewModel>

@{
    ViewData["Title"] = "Event Participants";
}

<div class="container mt-4">

    <h2>Event Participants</h2>

    <p class="text-muted">
        View participants enrolled in your event,
        their selected categories and enrolment status.
    </p>

    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category Selected</th>
                        <th>Enrolment Date</th>
                        <th>Enrolment Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ParticipantName</td>

                            <td>@item.CategoryName</td>

                            <td>
                                @item.EnrolmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @(item.Status ?? "Not recorded")
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Events"
       class="btn btn-secondary mt-3">
        Back to My Events
    </a>

</div>
