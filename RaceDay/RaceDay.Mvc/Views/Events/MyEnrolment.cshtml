@model RaceDay.Mvc.ViewModels.MyEnrolmentsVm

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <h2>My Enrolments</h2>

    <p>View the events you have enrolled in and their current status.</p>

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Enrolment Date</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Enrolments)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td>@item.EnrolmentDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge bg-success">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

</div>