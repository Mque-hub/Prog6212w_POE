```cshtml
@model List<RaceDay.Contracts.DTOs.EventDto>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container mt-4">

    <h2>Available Events</h2>

    <p class="text-muted">
        Explore available events and enter the ones you are interested in.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            There are currently no available events.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Event Type</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventType</td>
                            <td>@item.EventDate</td>
                            <td>@item.Location</td>
                            <td>@item.Distance</td>

                            <td>
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Events"
       asp-action="MyEvents"
       class="btn btn-success mt-3">
        My Events
    </a>

</div>
```